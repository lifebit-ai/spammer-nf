{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/lifebit-ai/spammer-nf/master/nextflow_schema.json",
  "title": "spammer-nf pipeline parameters",
  "description": "Stage one or more input files and print file metadata.",
  "type": "object",
  "properties": {
    "mainScript": {
      "type": "string",
      "default": "main.nf"
    },
    "config": {
      "type": "string",
      "default": "conf/standard.config"
    },
    "dataLocation": {
      "type": "string",
      "description": "One path/URI or a comma-separated list of paths/URIs to stage.",
      "default": "az://my-container/path/to/file.txt"
    },
    "echo": {
      "type": "boolean",
      "default": false
    },
    "cpus": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "container": {
      "type": "string",
      "default": "ubuntu:22.04"
    },
    "executor": {
      "type": "string",
      "default": "local"
    },
    "queueSize": {
      "type": "integer",
      "minimum": 1,
      "default": 100
    }
  },
  "required": [
    "dataLocation"
  ]
}
