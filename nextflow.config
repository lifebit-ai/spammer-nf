nextflow.enable.dsl = 2

profiles {

    // existing profiles...

    cloudos_smoke {
        process {
            // CloudOS usually injects container / executor via its own config,
            // so here we just keep it minimal and conservative.
            cpus = 1
            memory = '1 GB'
            time = '15 min'
        }

        params {
            n_jobs     = 1
            message    = 'CloudOS smoke run from spammer-nf'
            output_dir = 'results'
        }
    }
}
